digraph tx {
  rankdir=TB; bgcolor="white"; nodesep=1.3; ranksep=0.9; pad=0.3;
  node [shape=ellipse, style=filled, fontname="DejaVu Sans", fontsize=15, fillcolor="#dbe9ff", color="#2b5aa8", penwidth=1.6, width=1.3, height=0.8];
  edge [fontname="DejaVu Sans", fontsize=14, color="#333333", penwidth=1.3];
  IDLE  [label="IDLE\ntxd = 1\nbusy = 0", fillcolor="#d9f2d9", color="#2e7d32"];
  START [label="START\ntxd = 0"];
  DATA  [label="DATA\ntxd = D[bitn]"];
  PARITY[label="PARITY\ntxd = par_b", fillcolor="#fff3cd", color="#b58900"];
  STOP  [label="STOP\ntxd = 1", fillcolor="#fde0e0", color="#b3261e"];
  rst   [shape=circle, label="", width=0.2, fillcolor="black", color="black"];
  rst -> IDLE [label="rst_n = 0"];
  IDLE -> START   [label="tx_start = 1\n/ shreg ← tx_data\n  txd ← 0, par_b ← f(data)", constraint=true];
  START -> DATA   [label="tick\n/ txd ← shreg[0]\n  shift, bitn ← 0"];
  DATA -> DATA    [label="tick & bitn < 7\n/ txd ← shreg[0]\n  shift, bitn ← bitn + 1"];
  DATA -> PARITY  [label="tick & bitn = 7\n& PARITY ≠ 0\n/ txd ← par_b", color="#b58900"];
  DATA -> STOP    [label="tick & bitn = 7\n& PARITY = 0\n/ txd ← 1"];
  PARITY -> STOP  [label="tick\n/ txd ← 1", color="#b58900"];
  STOP -> IDLE    [label="tick\n/ tx_done ← 1"];
}
